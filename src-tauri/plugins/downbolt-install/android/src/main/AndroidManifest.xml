<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <application>
        <!-- کلاس جدا (نه FileProvider مستقیم): مرج مانیفست providerها را با
             android:name کلید می‌زند، پس کلاس یکسان + authority متفاوت هم
             تضاد می‌گرفت و بیلد 0.6.1 را دو بار انداخت. -->
        <provider
            android:name="ir.downbolt.plugin.install.DownboltFileProvider"
            android:authorities="${applicationId}.downbolt-fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/downbolt_file_paths" />
        </provider>
    </application>
</manifest>
