<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <application>
        <!-- authority جدا از provider قالب اپ: قالب خودش .fileprovider با
             @xml/file_paths خودش را دارد؛ authority یکسان + resource متفاوت
             = خطای مرج مانیفست (همین بیلد 0.6.1 را انداخت). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.downbolt-fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/downbolt_file_paths" />
        </provider>
    </application>
</manifest>
