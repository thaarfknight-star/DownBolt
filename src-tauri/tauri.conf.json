{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "height": 720,
        "label": "main",
        "minHeight": 540,
        "minWidth": 860,
        "resizable": true,
        "title": "DownBolt | دانلودمنیجر",
        "width": 1080
      }
    ]
  },
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "targets": [
      "nsis"
    ],
    "windows": {
      "nsis": {
        "compression": "lzma",
        "headerImage": "icons/installer-header.bmp",
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "sidebarImage": "icons/installer-sidebar.bmp"
      },
      "webviewInstallMode": {
        "silent": true,
        "type": "embedBootstrapper"
      }
    },
    "externalBin": [
      "binaries/DownBoltUpdater"
    ],
    "resources": {
      "../version.txt": "version.txt",
      "../CHANGELOG_FA.md": "CHANGELOG_FA.md"
    }
  },
  "identifier": "ir.downbolt.app",
  "productName": "DownBolt",
  "version": "0.6.4"
}
