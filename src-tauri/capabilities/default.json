{
  "$schema": "../gen/schemas/desktop-schema.json",
  "description": "دسترسی‌های پیش‌فرض پنجره‌ی اصلی",
  "identifier": "default",
  "permissions": [
    "core:default",
    "dialog:default",
    "downbolt-install:default",
    "downbolt-install:allow-install-apk",
    "downbolt-install:allow-publish-to-downloads",
    "downbolt-install:allow-delete-published",
    "downbolt-install:allow-open-file",
    "downbolt-install:allow-share-file",
    "downbolt-install:allow-pick-folder",
    "downbolt-install:allow-copy-to-folder",
    "downbolt-install:allow-delete-document",
    "downbolt-foreground:default",
    "downbolt-foreground:allow-sync-notification",
    "downbolt-foreground:allow-stop-notification"
  ],
  "windows": [
    "main"
  ]
}